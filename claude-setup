#!/usr/bin/env bash
# claude-setup — measure the Claude Code stack on this machine, then fix what is not there.
#
#   scan -> board -> pick -> preview -> apply -> rescan
#
# Every component in components/NN-name.sh has three functions:
#   <name>_detect   read-only; prints "STATE<TAB>detail"
#                   STATE: ok | partial | missing | broken | needs
#   <name>_plan     prints the commands / file edits apply would make
#   <name>_apply    makes them
# and may set <name>_deps (space-separated) and <name>_optional=1 (not pre-ticked).
# NN is the apply order. The rescan, not apply's exit code, is the proof.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
. "$ROOT/lib/ui.sh"
. "$ROOT/lib/claude.sh"

usage() {
  cat <<EOF
usage: claude-setup [--dry-run] [--yes] [--only a,b] [--redo a,b]

  (no flags)   scan, show the board, pick fixes, preview, confirm, apply, rescan
  --dry-run    stop after the preview; change nothing
  --yes        take the pre-ticked fixes and apply without prompting
  --only a,b   limit everything to these components
  --redo a,b   offer these even when they already read ok

Without a terminal and without --yes it stops after the preview.
Components: $(ls "$ROOT"/components | sed -E 's/^[0-9]+-//; s/\.sh$//' | tr '\n' ' ')
EOF
}

DRY=0 YES=0 ONLY='' REDO=''
while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) DRY=1 ;;
    --yes|-y)  YES=1 ;;
    --only)    ONLY=${2:?--only needs a list}; shift ;;
    --redo)    REDO=${2:?--redo needs a list}; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
command -v jq >/dev/null || { echo "jq is required: sudo apt install jq" >&2; exit 1; }

NAMES=()
for f in "$ROOT"/components/*.sh; do
  . "$f"
  n=$(basename "$f" .sh); n=${n#*-}
  [ -z "$ONLY" ] || [[ ",$ONLY," == *",$n,"* ]] || continue
  NAMES+=("$n")
done
fn() { echo "${1//-/_}"; }

declare -A STATE DETAIL
scan() {
  local n out
  for n in "${NAMES[@]}"; do
    [ -t 1 ] && printf '\r%sscanning %-16s%s' "$C_DIM" "$n" "$C_OFF"
    out=$("$(fn "$n")_detect" 2>/dev/null) || out="broken	detector failed"
    STATE[$n]=${out%%$'\t'*}
    DETAIL[$n]=${out#*$'\t'}
  done
  [ -t 1 ] && printf '\r%-40s\r' ''
  return 0
}

board() {
  ui_head "claude-setup · $(hostname) · $1"
  local n
  for n in "${NAMES[@]}"; do
    [ "${STATE[$n]}" = needs ] && continue
    printf '  %s %-15s %s\n' "$(ui_mark "${STATE[$n]}")" "$n" "${DETAIL[$n]}"
  done
  local any=0
  for n in "${NAMES[@]}"; do
    [ "${STATE[$n]}" = needs ] || continue
    [ $any = 1 ] || { printf '\n  %sneeds you%s (the wizard cannot do these)\n' "$C_PART" "$C_OFF"; any=1; }
    printf '  %s %-15s %s\n' "$(ui_mark needs)" "$n" "${DETAIL[$n]}"
  done
}

scan
board "scan"

# Fix candidates: anything not ok and not a human-only step, plus --redo.
CAND=() PRE=()
for n in "${NAMES[@]}"; do
  case ${STATE[$n]} in ok|needs) [[ ",$REDO," == *",$n,"* ]] || continue ;; esac
  CAND+=("$n")
  v="$(fn "$n")_optional"
  [ "${!v:-0}" = 1 ] || PRE+=("$n")
done
if [ ${#CAND[@]} -eq 0 ]; then printf '\nNothing to fix.\n'; exit 0; fi

if [ $YES = 0 ] && ui_interactive; then
  mapfile -t PICK < <(ui_choose_multi "Fix which? (space toggles, enter confirms)" \
    "$(IFS=,; echo "${PRE[*]-}")" "${CAND[@]}")
else
  PICK=("${PRE[@]}")
fi
if [ ${#PICK[@]} -eq 0 ]; then printf '\nNothing picked.\n'; exit 0; fi

ui_head "preview"
for n in "${PICK[@]}"; do
  printf '\n  %s\n' "$n"
  "$(fn "$n")_plan" | sed 's/^/    /'
done
if [ "$(claude_sessions)" -gt 0 ]; then
  for n in "${PICK[@]}"; do
    case $n in caveman|codegraph|claude2)
      printf '\n  %s%s claude session(s) running: they rewrite .claude.json and can undo MCP changes.\n  Close them before applying, or re-run afterwards to check.%s\n' \
        "$C_PART" "$(claude_sessions)" "$C_OFF"
      break ;;
    esac
  done
fi
printf '\n  Every JSON write is backed up first (*.bak-<timestamp>) and validated before it lands.\n'

[ $DRY = 1 ] && { printf '\nDry run: nothing changed.\n'; exit 0; }
if [ $YES = 0 ]; then
  ui_interactive || { printf '\nNo terminal: stopping after the preview. Re-run with --yes to apply.\n'; exit 0; }
  ui_confirm "Apply these?" || { echo "Nothing changed."; exit 0; }
fi

declare -A FAILED
for n in "${PICK[@]}"; do
  ui_head "apply · $n"
  deps="$(fn "$n")_deps"
  for d in ${!deps:-}; do
    if [ -n "${FAILED[$d]:-}" ]; then echo "  skipped: $d failed above"; FAILED[$n]=1; continue 2; fi
  done
  if ! "$(fn "$n")_apply"; then
    printf '  %sfailed%s\n' "$C_BAD" "$C_OFF"; FAILED[$n]=1
  fi
done

scan
board "after apply"
rc=0
for n in "${PICK[@]}"; do [ "${STATE[$n]}" = ok ] || rc=1; done
[ $rc = 0 ] && printf '\nAll picked components read ok.\n' || printf '\nSome picked components still do not read ok (see above).\n'
exit $rc
