#!/usr/bin/env bash
# claude-strapon — builds the Rust binary when the source changed, then runs it.
# Everything it does is in src/; see README.md.
set -euo pipefail
ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
command -v cargo >/dev/null || { echo "cargo is required: https://rustup.rs" >&2; exit 1; }
STRAPON_ROOT=$ROOT exec cargo run --release --quiet --manifest-path "$ROOT/Cargo.toml" -- "$@"
